# Copia este archivo a .env.local y rellena los valores.
# El sitio arranca y compila sin ninguna de estas variables: hoy el contenido
# sale de src/lib/placeholder/. Se vuelven obligatorias al conectar Sanity.

# --- Sanity: públicas (llegan al navegador) ---
# Se obtienen al crear el proyecto en sanity.io.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Sanity: secretas (solo servidor, NUNCA con prefijo NEXT_PUBLIC_) ---
# Token de la API. Rol Viewer basta para leer borradores en el preview;
# el script de carga scripts/ necesita permiso de escritura (rol Editor).
SANITY_API_TOKEN=

# Secreto compartido del webhook de revalidación. Debe coincidir con el campo
# "Secret" del webhook en manage.sanity.io. Es distinto del token de la API.
# Sin él, /api/revalidate rechaza todas las peticiones (falla cerrado).
SANITY_REVALIDATE_SECRET=

# --- Sitio ---
# Indexación en buscadores. Cerrada por defecto: ponla a "true" SOLO cuando el
# contenido sea definitivo. Hoy las fichas llevan fotografía de relleno, y
# desindexar cuesta mucho más que no aparecer.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Usado por sitemap.ts y robots.ts para las URLs absolutas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
